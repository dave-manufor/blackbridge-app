{
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "routePrefix": "/_/backend"
    }
  },
  "rewrites": [
    {
      "source": "/ws/:path*",
      "destination": "https://YOUR-ALWAYS-ON-SOCKET-SERVER.onrender.com/ws/:path*"
    }
  ]
}
