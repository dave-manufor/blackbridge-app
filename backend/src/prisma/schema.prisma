generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Users{
  id String @db.Uuid @id @default(uuid()) @unique
  email String @unique
  verified Boolean @default(false)
  profile_picture String? @db.Uuid
  salt String
  verifier String
  sessions Sessions[]
  keys Keys[]
  files Files[]
  transfers Transfers[]
  transfers_received EmailTransfers[]
  link_accesses LinkAccess[]
  link_downloads LinkTransferDownloads[]
  invites Invites[]
  brand_settings BrandSettings?
  p2p_sessions_sent P2PSessions[] @relation("SenderP2P")
  p2p_sessions_received P2PSessions[] @relation("ReceiverP2P")
  transfer_requests_made TransferRequests[] @relation("RequesterTransferRequests")
  transfer_requests_received TransferRequests[] @relation("RecipientTransferRequests")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  @@index([email], name: "idx_user_email")
}

model Keys{
  id String @db.Uuid @id @default(uuid()) @unique
  user_id String @db.Uuid
  primary Boolean @default(false)
  salt String
  public_key String
  private_key String
  version Int @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@unique([user_id, primary], name: "single_primary_key_pair_per_user")
  @@index([user_id], name: "idx_key_pair_user_id")
}

model Sessions{
  id String @db.Uuid @id @default(uuid()) @unique
  user_id String @db.Uuid
  hashed_refresh_token String @unique
  session_key String? @unique
  user_agent String
  browser String
  os String
  platform String
  device_name String?
  ip_address String
  revoked Boolean @default(false)
  revoked_at DateTime?
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user Users @relation(fields: [user_id], references: [id],onDelete: Cascade, onUpdate: Cascade)
  @@index([user_id], name: "idx_session_user_id")
}

enum FILE_STATUS {
  PENDING
  PROCESSING
  UPLOADED
  FAILED
}

model Files {
  id String @db.Uuid @id @default(uuid())
  user_id String @db.Uuid
  transfer_id String @db.Uuid
  status FILE_STATUS @default(PENDING)
  name String
  size BigInt @db.BigInt
  content_type String
  metadata Json? @db.JsonB
  blocks FileBlocks[]
  link_downloads LinkTransferDownloads[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  transfer Transfers @relation(fields: [transfer_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@index([user_id], name: "idx_file_user_id")
  @@index([status], name: "idx_file_status")
  @@index([transfer_id, status], name: "idx_files_transfer_status")
  @@index([user_id, transfer_id], name: "idx_files_user_transfer")
  

}

model FileBlocks {
  id String @db.Uuid @id @default(uuid())
  file_id String @db.Uuid
  index Int
  size Int
  encrypted_size Int?
  path String @unique
  upload_id String? @unique
  status FILE_STATUS @default(PENDING)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  file Files @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@index([file_id], name: "idx_file_blocks_file_id")
  @@index([file_id, status], name: "idx_file_id_status")
}

enum TRANSFER_TYPE {
  EMAIL
  LINK
}

enum TRANSFER_STATUS {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
}

model Transfers{
  id String @db.Uuid @id @default(uuid()) @unique
  owner_user_id String @db.Uuid
  owner_file_key String?
  transfer_type TRANSFER_TYPE
  title String?
  description String?
  status TRANSFER_STATUS @default(PENDING)
  expiration_date DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  email_transfers EmailTransfers[]
  link_transfer LinkTransfers?
  request TransferRequests?
  files Files[]
  invites Invites[]
  owner Users @relation(fields: [owner_user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@index([owner_user_id], name: "idx_transfer_owner_user_id")
  @@index([transfer_type], name: "idx_transfer_type")
  @@index([owner_user_id, status], name: "idx_transfers_owner_status")
  @@index([owner_user_id, transfer_type], name: "idx_transfers_owner_type")
  @@index([expiration_date], name: "idx_transfer_expiration_date")
}

model EmailTransfers{
  id String @db.Uuid @id @default(uuid()) @unique
  transfer_id String @db.Uuid
  recipient_user_id String @db.Uuid
  downloaded Boolean @default(false)
  downloaded_at DateTime?
  viewed Boolean @default(false)
  viewed_at DateTime?
  file_key String?
  created_at DateTime @default(now())
  transfer Transfers @relation(fields: [transfer_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recipient_user Users @relation(fields: [recipient_user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@index([recipient_user_id], name: "idx_user_transfers_recipient_user_id")
  @@index([transfer_id], name: "idx_user_transfer_id")
  @@index([viewed], name: "idx_user_transfers_viewed")
  @@index([viewed, recipient_user_id], name: "idx_user_transfers_viewed_recipient")
  @@unique([recipient_user_id, transfer_id], name: "unique_recipient_per_transfer")
}

enum LINK_ACCESS_CONTROL {
  PUBLIC
  REQUIRE_AUTH
  PRIVATE
}

model LinkTransfers{
  id String @db.Uuid @id @default(uuid()) @unique
  slug String @unique
  transfer_id String @db.Uuid @unique
  file_key String?
  encrypted_fragment String?
  access_control LINK_ACCESS_CONTROL @default(PUBLIC)
  is_password_protected Boolean @default(false)
  last_accessed DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  transfer Transfers @relation(fields: [transfer_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  link_accesses LinkAccess[]
  link_downloads LinkTransferDownloads[]
  @@index([transfer_id], name: "idx_link_transfer_id")
  @@index([access_control], name: "idx_link_access_control")
  @@index([transfer_id, access_control], name: "idx_link_transfer_access")
}

model LinkAccess {
  id String @db.Uuid @id @default(uuid()) @unique
  link_transfer_id String @db.Uuid
  user_id String @db.Uuid
  created_at DateTime @default(now())
  link_transfer LinkTransfers @relation(fields: [link_transfer_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@unique([link_transfer_id, user_id], name: "unique_link_user_access")
  @@index([user_id], name: "idx_link_access_user_id")
  @@index([link_transfer_id], name: "idx_link_access_link_transfer_id")
}

enum INVITE_STATUS {
  PENDING
  ACCEPTED
  APPROVED
}

model LinkTransferDownloads {
  id String @db.Uuid @id @default(uuid()) @unique
  file_id String @db.Uuid
  link_transfer_id String @db.Uuid
  user_id String? @db.Uuid
  created_at DateTime @default(now())
  file Files @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user Users? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  link_transfer LinkTransfers @relation(fields: [link_transfer_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@index([file_id], name: "idx_download_file_id")
  @@index([user_id], name: "idx_download_user_id")
  @@index([link_transfer_id], name: "idx_download_link_transfer_id")
}

model Invites {
  id String @db.Uuid @id @default(uuid()) @unique
  inviter_id String @db.Uuid
  transfer_id String @db.Uuid
  email String
  status INVITE_STATUS @default(PENDING)
  viewed_invite Boolean @default(false)
  viewed_authorization Boolean @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  transfer Transfers @relation(fields: [transfer_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  inviter Users @relation(fields: [inviter_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@unique([email, transfer_id], name: "unique_email_transfer")
  @@index([transfer_id], name: "idx_invite_transfer_id")
  @@index([email], name: "idx_invite_email")
}

enum P2P_SESSION_STATUS {
  ACTIVE
  CLOSED
}

model P2PSessions {
  id String @db.Uuid @id @default(uuid()) @unique
  owner_key String?
  receiver_key String?
  description String?
  room_id String @unique
  sender_id String @db.Uuid
  sender_socket_id String?
  receiver_id String @db.Uuid
  receiver_socket_id String?
  status P2P_SESSION_STATUS @default(ACTIVE)
  files_meta Json[] @db.JsonB
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  sender Users @relation("SenderP2P", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  receiver Users @relation("ReceiverP2P", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@index([sender_id], name: "idx_p2p_session_sender_id")
  @@index([receiver_id], name: "idx_p2p_session_receiver_id")
}

enum TRANSFER_REQUEST_STATUS {
  PENDING
  FULFILLED
  REJECTED
}

model TransferRequests {
  id String @db.Uuid @id @default(uuid()) @unique
  title String
  requester_id String @db.Uuid
  recipient_id String @db.Uuid
  transfer_id String? @db.Uuid @unique
  description String?
  files Json @db.JsonB
  status TRANSFER_REQUEST_STATUS @default(PENDING)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  requester Users @relation("RequesterTransferRequests", fields: [requester_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recipient Users @relation("RecipientTransferRequests", fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  transfer Transfers? @relation(fields: [transfer_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@unique([requester_id, transfer_id], name: "unique_requester_per_transfer")
  @@index([transfer_id], name: "idx_transfer_request_transfer_id")
  @@index([recipient_id], name: "idx_transfer_request_recipient_id")
  @@index([requester_id], name: "idx_transfer_request_requester_id")
  @@index([status], name: "idx_transfer_request_status")
}

model BrandSettings {
  id String @db.Uuid @id @default(uuid()) @unique
  enabled Boolean @default(false)
  user_id String @db.Uuid @unique
  name String
  logo String?
  primary_color String?
  secondary_color String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  owner Users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}