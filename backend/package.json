{
  "name": "ecee-file-transfer-api",
  "version": "1.0.0",
  "description": "Express API for ECEE File Transfer App",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon | npx pino-pretty",
    "email:dev": "email dev --dir src/services/notifications/templates/email",
    "build": "tsc && tsc-alias",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:migrate": "npx prisma migrate dev && npx prisma generate",
    "db:push": "npx prisma db push",
    "db:push:force": "npx prisma db push --force-reset"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "author": "David Manufor",
  "license": "ISC",
  "devDependencies": {
    "@openpgp/web-stream-tools": "^0.1.3",
    "@react-email/preview-server": "^4.2.8",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "eslint": "^9.24.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "prisma": "^6.6.0",
    "react-email": "4.2.8",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@react-email/components": "0.5.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express-useragent": "^1.0.5",
    "@types/image-to-base64": "^2.1.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/otp-generator": "^4.0.2",
    "@types/react": "^19.1.12",
    "aws-sdk": "^2.1692.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-useragent": "^1.0.15",
    "express-validator": "^7.2.1",
    "fast-srp-hap": "^2.0.4",
    "helmet": "^8.1.0",
    "image-to-base64": "^2.2.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.5",
    "nocache": "^4.0.0",
    "openpgp": "^6.1.0",
    "otp-generator": "^4.0.1",
    "p-limit": "^6.2.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pm2": "^6.0.8",
    "rate-limit-redis": "^4.2.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "redis": "^4.7.0",
    "resend": "^4.8.0",
    "tsc-alias": "^1.8.16",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  }
