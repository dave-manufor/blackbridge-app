# Ignore Terraform state files
*.tfstate
*.tfstate.*

# Ignore crash logs
crash.log

# Ignore Terraform variable files
*.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan output
*.tfplan

# Ignore .terraform directories except at root
**/.terraform/*

# Explicitly include the .terraform folder at the root
!/.terraform/